# ---------------------------------------------------------------------------
# Claude Code credential proxy — configuration
# Copy this file to `.env` and fill in the values, then run `npm start`.
# ---------------------------------------------------------------------------

# Port the proxy listens on (your friend points ANTHROPIC_BASE_URL here).
PORT=8787

# Interface to bind. 0.0.0.0 exposes it on all interfaces (needed if a remote
# client connects). Use 127.0.0.1 to restrict to localhost only.
HOST=0.0.0.0

# Shared secret your friend must send on every request. Make it long & random,
# e.g.  openssl rand -hex 32
PROXY_SECRET=change-me-to-a-long-random-string

# Header name the shared secret travels in (optional; defaults to x-proxy-secret).
PROXY_SECRET_HEADER=x-proxy-secret

# YOUR Claude subscription OAuth token. This is injected on every request so
# your friend never sees it. On the machine where you're logged into Claude
# Code, it lives in:
#   macOS:  Keychain item "Claude Code" (or ~/.claude/.credentials.json)
#   Linux:  ~/.claude/.credentials.json  ->  .claudeAiOauth.accessToken
# It starts with "sk-ant-oat...". Tokens expire, so refresh this if you start
# getting 401s from upstream.
ANTHROPIC_OAUTH_TOKEN=sk-ant-oat-your-token-here

# Upstream host to forward to (optional; defaults to api.anthropic.com).
UPSTREAM_HOST=api.anthropic.com
