# ---------------------------------------------------------------------------
# Claude Code credential proxy — configuration
# Copy this file to `.env` and fill in the values, then run `npm start`.
#
# The ONLY required setting is PROXY_SECRET. Your OAuth token is discovered
# automatically from your local Claude Code login and refreshed on the fly.
# ---------------------------------------------------------------------------

# [REQUIRED] Shared secret your friend must send on every request. Make it
# long & random — this is the ONE value you generate and share with them.
#   Linux/macOS:  openssl rand -hex 32
#   Windows PS :  -join ((1..32) | %{ '{0:x2}' -f (Get-Random -Max 256) })
PROXY_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL — sensible defaults are shown.
# ---------------------------------------------------------------------------

# Port the proxy listens on (your friend points ANTHROPIC_BASE_URL here).
PORT=8787

# Interface to bind. 0.0.0.0 exposes it on all interfaces (needed if a remote
# client connects). Use 127.0.0.1 to restrict to localhost only.
HOST=0.0.0.0

# Header name the shared secret travels in.
PROXY_SECRET_HEADER=x-proxy-secret

# --- OAuth token (auto-discovered; usually leave these alone) ---------------

# By default the proxy reads YOUR token from the local Claude Code credentials
# and auto-refreshes it when it expires — nothing to paste. Only set this to
# pin a specific token manually (disables auto-refresh):
# ANTHROPIC_OAUTH_TOKEN=sk-ant-oat-...

# Where Claude Code keeps credentials on this machine (auto-detected):
#   Linux / Windows:  ~/.claude/.credentials.json
#   macOS         :   same file, or the "Claude Code" Keychain item
# CLAUDE_CREDENTIALS_PATH=/home/you/.claude/.credentials.json

# Set to false to disable automatic token refresh.
# AUTO_REFRESH=true

# --- Model policy (optional) ------------------------------------------------
# Restrict which models the client may use. Values are comma-separated,
# case-insensitive substrings matched against the request's "model" field.
# Blocked requests get a 403 and never reach Anthropic (no quota spent).

# Block specific models, e.g. block Fable (matches claude-fable-5):
# BLOCKED_MODELS=fable

# OR allow ONLY these (everything else is blocked). Takes precedence:
# ALLOWED_MODELS=sonnet,haiku

# --- Effort cap (optional) --------------------------------------------------
# Reject requests whose reasoning effort exceeds this ceiling (403).
# Levels, low -> high: low, medium, high, xhigh, max.
# NOTE: Claude Code defaults to "xhigh", so a cap below xhigh means your friend
# must lower effort on their side (e.g. /config, or a lower setting) or those
# requests get rejected. Leave unset for no cap.
# MAX_EFFORT=high

# Upstream host to forward to.
UPSTREAM_HOST=api.anthropic.com
